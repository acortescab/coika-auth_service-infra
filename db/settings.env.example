# Copy to settings.env on the database host. Non-secret settings only: the DB user, password and
# name are read from SSM Parameter Store (<SSM_PREFIX>/db/POSTGRES_USER, POSTGRES_PASSWORD, POSTGRES_DB).

# Output `db_snapshots_bucket` of this Terraform stack (in a DR failover: the bucket of the DR region).
BACKUP_BUCKET=

# Optional (defaults shown)
# SSM_PREFIX=/coika/auth_service
# BACKUP_PREFIX=postgres
# AWS_REGION=              # default: the region of the instance
# POSTGRES_IMAGE=postgres:15   # pin a minor version (postgres:15.x) for reproducible rebuilds
